<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <TargetType>library</TargetType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>8600;8601;8618;8602;8603;8604;8625;1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Prowl.Runtime</AssemblyName>
    <RootNamespace>Prowl.Runtime</RootNamespace>
  </PropertyGroup>

  <!-- Allow test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Runtime.Test" />
    <InternalsVisibleTo Include="Prowl.Editor" />
    <InternalsVisibleTo Include="Prowl.Editor.Test" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/Runtime/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/Runtime/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- <PackageReference Include="Jitter2" Version="2.2.0" /> -->
    <PackageReference Include="Jitter2" />

    <!-- <ProjectReference Include="..\..\Anthology\Aperture\Aperture\Aperture.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Clay\Clay\Clay.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Echo\Echo\Echo.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Paper\Paper\Paper.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Unwrapper\Unwrapper\Unwrapper.csproj" /> -->
    <PackageReference Include="Prowl.Aperture" />
    <PackageReference Include="Prowl.Clay" />
    <PackageReference Include="Prowl.Echo" />
    <PackageReference Include="Prowl.Paper" />
    <PackageReference Include="Prowl.Recast" />
    <PackageReference Include="Prowl.Unwrapper" />
    
    <PackageReference Include="Silk.NET" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <!-- <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" /> -->
    <PackageReference Include="Prowl.Ember.Contracts" />
    <!-- EngineObject null-safety analyzer (?./??/??= on EngineObject). Analyzes this project's own source. -->
    <ProjectReference Include="..\Zenith.Analyzers\Zenith.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\**" />
    <EmbeddedResource Include="Assets\brdf_lut.brdf" />
  </ItemGroup>

  <ItemGroup>
    <LibraryFiles Include="..\Libraries\**\*.*" />
  </ItemGroup>

  <!-- Stamp each PackageReference as AssemblyMetadata so the build pipeline
       can read dependencies from the compiled DLL without needing the .csproj file.
       Central Package Management keeps versions on the central PackageVersion item,
       and MSBuild cannot pair two item types inside a target (cross-item %() in
       conditions never matches and item-function arguments do not expand %()), so
       pair them by item identity: Remove matches on Identity, which leaves exactly
       the central versions this project references. Only those are embedded,
       mirroring the previous behavior of stamping references with a non-empty Version. -->
  <Target Name="EmbedPackageReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_CentralUnreferenced Include="@(PackageVersion)" />
      <_CentralUnreferenced Remove="@(PackageReference)" />
      <_CentralUsed Include="@(PackageVersion)" />
      <_CentralUsed Remove="@(_CentralUnreferenced)" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PackageReference:%(_CentralUsed.Identity)</_Parameter1>
        <_Parameter2>%(_CentralUsed.Version)</_Parameter2>
      </AssemblyAttribute>
      <_CentralUnreferenced Remove="@(_CentralUnreferenced)" />
      <_CentralUsed Remove="@(_CentralUsed)" />
    </ItemGroup>
  </Target>

  <!-- Copy native libraries to output -->
  <Target Name="CopyLibraries" AfterTargets="Build">
    <Copy SourceFiles="@(LibraryFiles)" DestinationFiles="@(LibraryFiles->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Collect runtime files for referencing projects -->
  <ItemGroup>
    <None Include="..\Libraries\**\*.*">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
