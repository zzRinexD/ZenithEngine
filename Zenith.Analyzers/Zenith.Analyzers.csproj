<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Applied to the engine and user scripts as a Roslyn analyzer, not shipped as a normal library. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>Prowl.Analyzers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- VersionOverride: the SDK 10.0.100 compiler host is Roslyn 5.0.0. Building this analyzer
         against the central 5.6.0 loads without CS8034 but silently emits no diagnostics
         (verified A/B: PROWLMB003 disappears at 5.6.0 and returns at 4.8.0). Keep pinned to the
         host's Roslyn line; drop the override once the SDK ships Roslyn >= 5.6.0. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
